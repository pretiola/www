# Copy to .env; never commit credentials. .env is gitignored.
PORT=8091
# capture (no external delivery), telegram, or smtp
NOTIFICATION_MODE=capture
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs. Each recipient must first start the bot.
TELEGRAM_USER_IDS=
# Telegram sends full lead details to these recipients. SQLite remains the source of record.
# Optional SMTP alternative:
# SMTP_HOST=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=
# INTAKE_EMAIL=
